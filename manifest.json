{
  "manifest_version": 3,
  "name": "Watch Later: YouTube Playlists & Feeds",
  "version": "0.2.4",
  "description": "Search, move and copy playlist videos. Restore removals and build feeds from channels and categories.",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "Open Watch Later: YouTube Playlists & Feeds",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "optional_host_permissions": [
    "https://web.archive.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'"
  }
}
