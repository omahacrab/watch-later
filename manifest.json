{
  "manifest_version": 3,
  "name": "Watch Later Cleaner",
  "version": "0.1.29",
  "description": "Search your Watch Later playlist, review selections, and remove videos in batches of 500.",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "Open Watch Later Cleaner",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "optional_host_permissions": [
    "https://web.archive.org/*"
  ]
}
